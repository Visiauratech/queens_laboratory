<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --------------------------------------------------
  # Laravel API  →  /api/*  maps to  /api/public/*
  # Contact endpoint: POST /api/contact
  # --------------------------------------------------
  RewriteCond %{REQUEST_URI} ^/api/public/
  RewriteRule ^api/public/(.*)$ api/public/$1 [L]

  # Serve real files inside api/public directly
  RewriteCond %{REQUEST_URI} ^/api/(.*)$
  RewriteCond %{DOCUMENT_ROOT}/api/public/%1 -f
  RewriteRule ^api/(.*)$ api/public/$1 [L]

  # Send remaining /api requests to Laravel front controller
  RewriteRule ^api(?:/(.*))?$ api/public/index.php [QSA,L]

  # --------------------------------------------------
  # React SPA — prevent 404 on refresh
  # --------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
  Header set Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT, PATCH, DELETE"
  Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Accept, Origin"
</IfModule>

# Disable directory listing
Options -Indexes
